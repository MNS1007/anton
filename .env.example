# Twilio: console.twilio.com > Account info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number you bought, in +1XXXXXXXXXX form
TWILIO_NUMBER=
# Your own phone. The only number Anton will talk to.
MY_NUMBER=

# OpenAI key for the voice (Realtime API)
OPENAI_API_KEY=

# What Anton calls itself and you
ASSISTANT_NAME=Anton
USER_NAME=

# Folder Claude Code works in (defaults to where you start Anton).
# Point it at the folder that holds all your repos so Claude can reach any of them
# and clone new ones there. Example: ~/code or C:/Users/you/source/repos
WORK_DIR=
# More folders Claude may use, separated by ; (optional)
EXTRA_DIRS=

# Claude Code permission mode: default, acceptEdits, auto, plan
# Anything not allowed by this mode or your Claude settings is asked on the phone.
PERMISSION_MODE=acceptEdits
# Extra tools Claude may use without asking, space separated. Example: Bash(npm test) Bash(git status)
ALLOWED_TOOLS=
# Most Claude sessions working at the same time
MAX_RUNNING=3

# Call again this many minutes after a missed call, until you pick up
RETRY_MINUTES=15
# Stop after this many missed calls in a row. 0 means never stop.
MAX_ATTEMPTS=0
# No calls between these hours, local time. Example: 22-7
QUIET_HOURS=

# Voice settings
REALTIME_MODEL=gpt-realtime-2.1
VOICE=cedar
# Transcribes what you say on calls, for Anton's memory
TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# realtime (default) or live. live uses GPT-Live, OpenAI's full-duplex voice model:
# it listens while it talks, so you can cut in naturally. See "Voice engines" in the README.
VOICE_ENGINE=realtime
LIVE_MODEL=gpt-live-1
LIVE_VOICE=cedar
# The model GPT-Live hands tool calls to
LIVE_BACKEND_MODEL=gpt-5.5
# Only for calls that reach OpenAI over a SIP trunk: the signing secret of the
# OpenAI webhook that points at <your public url>/live/incoming
OPENAI_WEBHOOK_SECRET=

# Where sessions and memory are kept
ANTON_HOME=~/.anton
# Claude model that writes call summaries
MEMORY_MODEL=haiku
# Least hours between rewrites of Anton's understanding of you (memory/understanding.md). 0 turns it off
REFLECT_HOURS=6

# Advanced: leave PUBLIC_URL empty to use a free Cloudflare tunnel.
# Set it if you have your own https address that forwards to PORT.
PORT=8787
PUBLIC_URL=
# Set to false if you set the number's voice webhook yourself
SET_WEBHOOK=true

# porch hub (optional): https://github.com/MNS1007/porch
# Anton reads what your other agents post, takes tasks you post for it,
# and calls you when an agent needs you. Leave empty to turn it off.
# With porch set and no Twilio/OpenAI values, Anton runs on porch only.
PORCH_URL=
PORCH_TOKEN=
# Your own name on porch. Only your messages can give Claude tasks.
PORCH_BOSS=me
# Room where Anton posts Claude's updates and questions
PORCH_ROOM=anton
# Which posts from other agents make Anton call: for-me, urgent, questions, all, none
PORCH_CALL_ON=for-me,urgent
# Most porch-triggered calls a day. 0 means no limit.
PORCH_CALLS_PER_DAY=4
